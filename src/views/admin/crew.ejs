<%
const notices = { added: "Operator added.", updated: "Operator updated.", removed: "Operator removed from the crew list." };
const f = editing && !form.name
  ? { name: editing.name, phone: editing.phone, ownVehicle: editing.own_vehicle, notes: editing.notes }
  : form;
%>
<%- include("../partials/admin-head", { title: "Crew" }) %>
<%- include("../partials/admin-nav") %>

<div class="container wide-cal">
  <h1>Crew</h1>
  <p class="help">Your camera operators. Add them once here, then pick them on any funeral to ask them on WhatsApp.</p>

  <% if (notice && notices[notice]) { %><div class="notice-box"><%= notices[notice] %></div><% } %>

  <div class="crew-layout">
    <div class="panel">
      <h2 class="panel-title"><%= editing ? "Edit " + editing.name : "Add an operator" %></h2>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="post" action="<%= editing ? `/admin/crew/${editing.id}/edit` : '/admin/crew' %>">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required value="<%= f.name || '' %>" />

        <label for="phone">WhatsApp number</label>
        <input type="tel" id="phone" name="phone" required placeholder="082 123 4567" value="<%= f.phone || '' %>" />

        <label>Own vehicle?</label>
        <div class="radio-row">
          <label class="pick"><input type="radio" name="ownVehicle" value="1" <%= String(f.ownVehicle) === "1" ? "checked" : "" %> /> Yes</label>
          <label class="pick"><input type="radio" name="ownVehicle" value="0" <%= String(f.ownVehicle) !== "1" ? "checked" : "" %> /> No</label>
        </div>

        <label for="notes">Notes / rate</label>
        <input type="text" id="notes" name="notes" placeholder="e.g. R1 200 per funeral, experienced on YoloBox" value="<%= f.notes || '' %>" />

        <div style="margin-top:20px;">
          <button class="btn" type="submit"><%= editing ? "Save" : "Add operator" %></button>
          <% if (editing) { %><a class="btn secondary" href="/admin/crew">Cancel</a><% } %>
        </div>
      </form>
    </div>

    <div class="panel">
      <h2 class="panel-title">Operators (<%= crew.length %>)</h2>
      <% if (crew.length === 0) { %>
        <p class="help">No operators yet — add your first one on the left.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Name</th><th>WhatsApp</th><th>Own car</th><th>Notes / rate</th><th>Upcoming</th><th></th></tr></thead>
          <tbody>
            <% crew.forEach(c => { %>
              <tr>
                <td><strong><%= c.name %></strong></td>
                <td><%= c.phone %></td>
                <td><%= c.own_vehicle ? "Yes" : "No" %></td>
                <td><%= c.notes || "—" %></td>
                <td><%= c.upcoming || 0 %></td>
                <td class="row-actions">
                  <a href="/admin/crew?edit=<%= c.id %>">Edit</a>
                  <form method="post" action="/admin/crew/<%= c.id %>/remove" onsubmit="return confirm('Remove <%= c.name.replace(/'/g, '') %> from the crew list?');">
                    <button class="link-btn" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
