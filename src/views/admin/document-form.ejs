<%
const isQuote = doc.kind === "quote";
const label = isQuote ? "Quote" : "Invoice";
const rands = (c) => (c / 100).toFixed(2);
%>
<%- include("../partials/admin-head", { title: label + " · " + stream.title }) %>
<%- include("../partials/admin-nav") %>

<div class="container doc-form-wrap">
  <p class="help" style="margin-bottom:4px;"><a href="/admin/streams/<%= stream.slug %>#billing">← <%= stream.title %></a></p>
  <h1><%= doc.number ? "Edit " + label.toLowerCase() + " " + doc.number : "New " + label.toLowerCase() %></h1>
  <% if (!isQuote && !doc.id) { %>
    <p class="help">Pre-filled from the quote where there is one — check the amounts, then save.</p>
  <% } %>

  <div class="panel">
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <form method="post" action="/admin/streams/<%= stream.slug %>/<%= doc.kind %>/edit" id="docForm">
      <fieldset class="form-section">
        <legend>Bill to</legend>
        <div class="grid-2">
          <div>
            <label for="billToName">Name</label>
            <input type="text" id="billToName" name="billToName" required value="<%= doc.bill_to_name || '' %>" />
          </div>
          <div>
            <label for="billToPhone">Phone</label>
            <input type="tel" id="billToPhone" name="billToPhone" value="<%= doc.bill_to_phone || '' %>" />
          </div>
        </div>
        <div class="grid-2">
          <div>
            <label for="billToEmail">Email (optional)</label>
            <input type="email" id="billToEmail" name="billToEmail" value="<%= doc.bill_to_email || '' %>" />
          </div>
          <div>
            <label for="billToAddress">Address / company (optional)</label>
            <textarea id="billToAddress" name="billToAddress" class="short" rows="3"><%= doc.bill_to_address || '' %></textarea>
          </div>
        </div>
      </fieldset>

      <fieldset class="form-section">
        <legend>Dates</legend>
        <div class="grid-2">
          <div>
            <label for="issueDate"><%= label %> date</label>
            <input type="date" id="issueDate" name="issueDate" value="<%= doc.issue_date %>" />
          </div>
          <div>
            <label for="dueDate"><%= isQuote ? "Valid until" : "Payment due" %></label>
            <input type="date" id="dueDate" name="dueDate" value="<%= doc.due_date || '' %>" />
          </div>
        </div>
      </fieldset>

      <fieldset class="form-section">
        <legend>Items</legend>
        <div class="grid-2">
          <div>
            <label for="packageLabel">Package</label>
            <input type="text" id="packageLabel" name="packageLabel" value="<%= doc.package_label %>" />
          </div>
          <div>
            <label for="packagePrice">Package price (R)</label>
            <input type="text" inputmode="decimal" id="packagePrice" name="packagePrice" class="calc" value="<%= rands(doc.package_cents) %>" />
          </div>
        </div>
        <label for="packageDetails">What's included (one per line)</label>
        <textarea id="packageDetails" name="packageDetails" class="short"><%= doc.package_details || '' %></textarea>

        <label class="pick check-row">
          <input type="checkbox" id="chargeTransport" name="chargeTransport" value="1" class="calc" <%= doc.charge_transport ? "checked" : "" %> />
          <span>Charge transport / petrol</span>
        </label>
        <div class="grid-2" id="transportFields">
          <div>
            <label for="transportKm">Distance (km, return trip)</label>
            <input type="text" inputmode="decimal" id="transportKm" name="transportKm" class="calc" value="<%= doc.transport_km || '' %>" placeholder="e.g. 80" />
          </div>
          <div>
            <label for="transportRate">Rate per km (R)</label>
            <input type="text" inputmode="decimal" id="transportRate" name="transportRate" class="calc" value="<%= rands(doc.transport_rate_cents) %>" />
          </div>
        </div>

        <label>Extra gear <span class="legend-note">from the funeral — change it on the funeral and it updates here</span></label>
        <% if (doc.gear && doc.gear.length) { %>
          <div class="gear-ro" id="gearRo" data-total="<%= (doc.gear.reduce((t, g) => t + Math.round((Number(g.qty) || 0) * (Number(g.unit_cents) || 0)), 0) / 100).toFixed(2) %>">
            <% doc.gear.forEach(g => { const lt = Math.round((Number(g.qty) || 0) * (Number(g.unit_cents) || 0)); %>
              <div class="gear-ro-row"><span><%= g.qty %> × <%= g.label %></span><span><%= lt ? fmtR(lt) : "Included" %></span></div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="help" id="gearRo" data-total="0">No extra gear on this funeral.</p>
        <% } %>
        <p class="help"><% if (doc.kind === "invoice" && doc.paid_at) { %>This invoice is paid, so its gear is locked as it was.<% } else { %><a href="/admin/streams/<%= stream.slug %>/edit">Edit gear on the funeral →</a><% } %></p>

        <label>Other items <span class="legend-note">anything that isn't gear, e.g. USB copy of the recording — price 0 shows as "Included"</span></label>
        <div class="item-head"><span>Description</span><span>Qty</span><span>Price each (R)</span><span>Line total</span><span></span></div>
        <div id="itemRows" class="item-rows">
          <% const rows = (doc.items && doc.items.length) ? doc.items : [{ label: "", qty: 1, unit_cents: 0 }]; %>
          <% rows.forEach(it => { %>
            <div class="item-row">
              <input type="text" name="itemLabel" placeholder="e.g. USB copy of the recording" value="<%= it.label || '' %>" />
              <input type="text" inputmode="decimal" name="itemQty" class="qty" value="<%= it.qty || 1 %>" />
              <input type="text" inputmode="decimal" name="itemPrice" value="<%= rands(it.unit_cents || 0) %>" />
              <span class="item-total">—</span>
              <button type="button" class="link-btn item-remove" title="Remove line">✕</button>
            </div>
          <% }) %>
        </div>
        <button type="button" class="btn small secondary" id="addItem">+ Add line</button>


        <div class="total-box">
          <span>Total</span>
          <strong id="totalOut">—</strong>
        </div>
        <p class="help" id="transportOut"></p>
      </fieldset>

      <label for="notes">Notes on the <%= label.toLowerCase() %> (optional)</label>
      <textarea id="notes" name="notes" class="short"><%= doc.notes || '' %></textarea>

      <div style="margin-top:20px;">
        <button class="btn" type="submit">Save &amp; view <%= label.toLowerCase() %></button>
        <a class="btn secondary" href="/admin/streams/<%= stream.slug %>#billing">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
  // Live total while editing (the server recalculates on save).
  (function () {
    const $ = (id) => document.getElementById(id);
    const num = (v) => { const n = parseFloat(String(v).replace(/[R\s]/gi, "").replace(",", ".")); return isFinite(n) ? n : 0; };
    const fmt = (r) => "R" + r.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, " ");
    function update() {
      const on = $("chargeTransport").checked;
      $("transportFields").style.display = on ? "" : "none";
      const transport = on ? Math.round(num($("transportKm").value) * num($("transportRate").value) * 100) / 100 : 0;
      let extras = 0;
      document.querySelectorAll("#itemRows .item-row").forEach((row) => {
        const label = row.querySelector('[name="itemLabel"]').value.trim();
        const line = label ? (num(row.querySelector('[name="itemQty"]').value) || 1) * num(row.querySelector('[name="itemPrice"]').value) : 0;
        row.querySelector(".item-total").textContent = label ? (line ? fmt(line) : "Included") : "—";
        extras += line;
      });
      const gearTotal = num($("gearRo").getAttribute("data-total"));
      $("totalOut").textContent = fmt(num($("packagePrice").value) + transport + gearTotal + extras);
      $("transportOut").textContent = on ? "Transport: " + num($("transportKm").value) + " km × " + fmt(num($("transportRate").value)) + " = " + fmt(transport) : "";
    }
    const rowsEl = $("itemRows");
    $("addItem").addEventListener("click", () => {
      const row = rowsEl.querySelector(".item-row").cloneNode(true);
      row.querySelector('[name="itemLabel"]').value = "";
      row.querySelector('[name="itemQty"]').value = "1";
      row.querySelector('[name="itemPrice"]').value = "0.00";
      rowsEl.appendChild(row);
      row.querySelector("input").focus();
      update();
    });
    rowsEl.addEventListener("click", (e) => {
      if (!e.target.classList.contains("item-remove")) return;
      const row = e.target.closest(".item-row");
      if (rowsEl.querySelectorAll(".item-row").length > 1) row.remove();
      else row.querySelectorAll("input").forEach((i) => (i.value = i.name === "itemQty" ? "1" : i.name === "itemPrice" ? "0.00" : ""));
      update();
    });
    document.getElementById("docForm").addEventListener("input", update);
    update();
  })();
</script>
</body>
</html>
