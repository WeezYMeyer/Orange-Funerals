<%
const f = form || {
  title: stream.title,
  embedCode: stream.embed_code,
  serviceDate: stream.service_date || "",
  venueName: stream.venue_name,
  venueAddress: stream.venue_address,
  mapsLink: stream.maps_link,
  contactName: stream.contact_name,
  contactPhone: stream.contact_phone,
  arrivalTime: stream.arrival_time,
  crewNotes: stream.crew_notes,
  kitId: stream.kit_id,
  leadSource: stream.lead_source,
  accountClient: stream.account_client,
  branch: stream.branch,
  chatEnabled: stream.chat_enabled,
  gear: (() => { try { return JSON.parse(stream.extra_gear || "[]"); } catch (e) { return []; } })(),
};
%>
<%- include("../partials/admin-head", { title: "Edit " + stream.title }) %>
<%- include("../partials/admin-nav") %>

<div class="container doc-form-wrap">
  <h1>Edit Livestream</h1>
  <p class="help">The public link (<code><%= stream.slug %></code>) never changes here — safe to update details even after you've sent the link out. If you change the venue or time after an operator was confirmed, press <strong>Send details again</strong> on the funeral page so they get the update.</p>

  <div class="panel">
    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/streams/<%= stream.slug %>/edit">
      <%- include("../partials/stream-fields", { f, kits, sources, accounts }) %>
      <button class="btn" type="submit">Save Changes</button>
      <a class="btn secondary" href="/admin/streams/<%= stream.slug %>">Cancel</a>
    </form>
  </div>
</div>
</body>
</html>
