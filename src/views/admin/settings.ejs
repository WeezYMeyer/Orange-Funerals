<%
const field = (key, label, opts = {}) => ({ key, label, ...opts });
const groups = [
  ["Pretoria branch – letterhead on quotes & invoices", [
    field("business_name", "Business name"),
    field("business_address", "Address"),
    field("business_phone", "Phone"),
    field("business_email", "Email"),
    field("business_website", "Website"),
  ]],
  ["Cape Town branch – letterhead on quotes & invoices", [
    field("ct_business_name", "Business name"),
    field("ct_business_address", "Address"),
    field("ct_business_phone", "Phone"),
    field("ct_business_email", "Email"),
    field("ct_business_website", "Website"),
  ]],
  ["Pretoria branch – banking details (used when a funeral's branch is Pretoria)", [
    field("bank_account_holder", "Account holder"),
    field("bank_name", "Bank", { placeholder: "e.g. FNB" }),
    field("bank_branch_name", "Branch name"),
    field("bank_account_type", "Account type", { placeholder: "e.g. Cheque / Business" }),
    field("bank_account_number", "Account number"),
    field("bank_branch_code", "Branch code"),
    field("bank_swift", "SWIFT code (for international payments)"),
  ]],
  ["Cape Town branch – banking details (used when a funeral's branch is Cape Town)", [
    field("ct_bank_account_holder", "Account holder"),
    field("ct_bank_name", "Bank"),
    field("ct_bank_branch_name", "Branch name"),
    field("ct_bank_account_type", "Account type"),
    field("ct_bank_account_number", "Account number"),
    field("ct_bank_branch_code", "Branch code"),
    field("ct_bank_swift", "SWIFT code"),
  ]],
  ["Operator confirmation WhatsApp", [
    field("crew_guidelines_message", "Added to the end of every confirmation brief (leave empty to switch off)", { textarea: true }),
  ]],
  ["Default package & pricing (pre-filled on every new quote)", [
    field("package_label", "Package name"),
    field("package_price", "Package price (R)"),
    field("package_details", "What's included (one per line)", { textarea: true }),
    field("transport_rate", "Transport rate per km (R)"),
  ]],
  ["Terms", [
    field("quote_valid_days", "Quotes valid for (days)"),
    field("invoice_due_days", "Invoice due after (days) — the service date is used if later"),
    field("payment_terms", "Payment terms on invoices", { textarea: true }),
    field("vat_note", "VAT note under the total"),
  ]],
];
%>
<%- include("../partials/admin-head", { title: "Business settings" }) %>
<%- include("../partials/admin-nav") %>

<div class="container narrow">
  <h1>Business settings</h1>
  <p class="help"><a href="/admin/staff">Staff logins →</a> give each person their own login, so quotes and invoices show who prepared them.</p>
  <p class="help">Used on quotes and invoices. Changes apply to documents from now on — open an existing quote or invoice to see them updated too.</p>
  <% if (notice === "saved") { %><div class="notice-box">Settings saved.</div><% } %>

  <div class="panel">
    <form method="post" action="/admin/settings">
      <% groups.forEach(([title, fields]) => { %>
        <fieldset class="form-section">
          <legend><%= title %></legend>
          <% fields.forEach(fl => { %>
            <label for="<%= fl.key %>"><%= fl.label %></label>
            <% if (fl.textarea) { %>
              <textarea id="<%= fl.key %>" name="<%= fl.key %>" class="short"><%= s[fl.key] || '' %></textarea>
            <% } else { %>
              <input type="text" id="<%= fl.key %>" name="<%= fl.key %>" placeholder="<%= fl.placeholder || '' %>" value="<%= s[fl.key] || '' %>" />
            <% } %>
          <% }) %>
        </fieldset>
      <% }) %>
      <button class="btn" type="submit">Save settings</button>
    </form>
  </div>

  <% if (typeof live !== "undefined" && live) { %>
  <div class="panel" id="live">
    <h2 class="panel-title">Orange live server</h2>
    <% if (!live.enabled) { %>
      <p class="help">Off. Funerals use YoloLive embed codes. To switch it on, add the <strong>LIVE_…</strong> variables from the orange-live stack under Environment in Render.</p>
    <% } else { %>
      <p class="help">
        On. A funeral with a kit and <strong>no</strong> YoloLive embed code plays that kit's YoloBox, records it, emails the family the recording, reminds them 3 days before it expires and deletes it after <strong><%= live.recordingDays %> days</strong>.
      </p>
      <% if (!live.s3Ready || !live.awsKeysSet) { %>
        <div class="error-box">Recordings can't be found yet: add <strong>LIVE_RECORDINGS_BUCKET</strong>, <strong>LIVE_AWS_ACCESS_KEY_ID</strong> and <strong>LIVE_AWS_SECRET_ACCESS_KEY</strong> in Render.</div>
      <% } %>
      <% if (!live.passwordSet) { %>
        <div class="error-box">Add <strong>LIVE_STREAM_PASSWORD</strong> in Render so the full stream keys show below.</div>
      <% } %>
      <p class="help">
        Last check <%= live.lastTickAt ? new Date(live.lastTickAt).toLocaleString("en-ZA", { timeZone: "Africa/Johannesburg" }) : "— not yet" %>
      </p>
      <% if (live.lastError) { %><div class="error-box">Last problem (<%= new Date(live.lastErrorAt).toLocaleString("en-ZA", { timeZone: "Africa/Johannesburg" }) %>): <%= live.lastError %></div><% } %>

      <h3 style="margin:18px 0 6px; font-size:15px;">YoloBox settings (Custom RTMP) — enter once per kit</h3>
      <label>RTMP URL (the same for every kit)</label>
      <code class="kit-key"><%= live.rtmpUrl || "LIVE_RTMP_URL not set" %></code>
      <% live.kits.forEach(k => { %>
        <div style="margin-top:14px;">
          <strong><%= k.name %></strong>
          <% if (k.is_live) { %><span class="tag live">Streaming</span><% } else if (k.checked_at) { %><span class="tag">Off</span><% } %>
          · <a href="<%= k.testUrl %>" target="_blank">Test player</a>
          <label style="margin-top:4px;">Stream key</label>
          <code class="kit-key"><%= k.streamKey %></code>
        </div>
      <% }) %>
      <p class="help">Recommended YoloBox video: 720p, 25 fps, about 2.5 Mbps.</p>
    <% } %>
  </div>
  <% } %>

  <% if (typeof crm !== "undefined" && crm) { %>
  <div class="panel" id="crm">
    <h2 class="panel-title">Orange Platform CRM</h2>
    <% if (notice === "crm-resync") { %><div class="notice-box">Every contact is queued and on its way to the CRM.</div><% } %>
    <% if (!crm.enabled) { %>
      <p class="help">Off. Viewers and billed clients are not being sent to the Orange Platform. To switch it on, add <strong>CRM_SUPABASE_URL</strong>, <strong>CRM_SUPABASE_KEY</strong> and <strong>CRM_INGEST_SECRET</strong> under Environment in Render.</p>
    <% } else { %>
      <p class="help">
        On. Everyone who enters their email on a watch page, everyone billed on a quote or invoice, and every unsubscribe goes to the Contacts page in Orange Platform.
      </p>
      <p class="help">
        Waiting to send: <strong><%= crm.waiting %></strong><% if (crm.failing) { %> (<%= crm.failing %> retrying)<% } %>
        <% if (crm.lastSyncAt) { %> · last sent <%= new Date(crm.lastSyncAt).toLocaleString("en-ZA", { timeZone: "Africa/Johannesburg" }) %><% } %>
      </p>
      <% if (crm.lastError) { %><div class="error-box">Last problem: <%= crm.lastError %></div><% } %>
      <form method="post" action="/admin/crm/resync" style="margin-top:10px">
        <button class="btn small secondary" type="submit">Send everyone again</button>
      </form>
    <% } %>
  </div>
  <% } %>
</div>
</body>
</html>
