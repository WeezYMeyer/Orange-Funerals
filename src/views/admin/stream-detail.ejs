<%
let noticeHtml = null;
if (notice === "already-sent") {
  noticeHtml = "Thank-you emails were already sent for this stream — nothing sent again.";
} else if (notice && notice.startsWith("thanks-sent-")) {
  const [ , , sent, failed, skipped ] = notice.split("-");
  noticeHtml = `Thank-you emails: ${sent} sent, ${failed} failed, ${skipped} skipped (opted out).`;
} else if (notice && notice.startsWith("email-error-")) {
  noticeHtml = "Sending thank-you emails failed: " + decodeURIComponent(notice.replace("email-error-", "")) + " — check the email settings in Render.";
} else if (notice === "updated") {
  noticeHtml = "Stream details updated. The public link is unchanged.";
}

function fmtScheduled(dateStr) {
  if (!dateStr) return null;
  const d = new Date(dateStr);
  if (isNaN(d)) return null;
  const hasTime = /T\d{2}:\d{2}/.test(dateStr);
  return hasTime
    ? d.toLocaleString(undefined, { year: "numeric", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit" })
    : d.toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
}
const scheduled = fmtScheduled(stream.service_date);
%>
<%- include("../partials/admin-head", { title: stream.title }) %>
<%- include("../partials/admin-nav") %>

<div class="container">
  <div style="display:flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap;">
    <h1 style="margin-bottom:4px;"><%= stream.title %></h1>
    <div>
      <a class="btn secondary" href="/admin/streams/<%= stream.slug %>/edit">Edit</a>
    </div>
  </div>
  <p class="help" style="margin-top:0;">
    Loaded by <strong><%= stream.creator_name || "—" %></strong>
    <% if (scheduled) { %> · Scheduled for <strong><%= scheduled %></strong><% } %>
  </p>

  <% if (noticeHtml) { %>
    <div class="notice-box"><%= noticeHtml %></div>
  <% } %>

  <div class="panel">
    <label style="margin-top:0;">Public link — send this to family or post it wherever people will find it</label>
    <div class="link-box"><a href="<%= publicUrl %>" target="_blank"><%= publicUrl %></a></div>

    <label>Status</label>
    <% if (stream.ended_at) { %>
      <p><span class="tag ended">Ended <%= new Date(stream.ended_at + "Z").toLocaleString() %></span></p>
    <% } else { %>
      <p><span class="tag live">Live / Open</span></p>
      <form method="post" action="/admin/streams/<%= stream.slug %>/end" onsubmit="return confirm('End this stream and send thank-you emails to everyone who watched?');">
        <button class="btn danger" type="submit">End Stream &amp; Send Thank-You Emails</button>
      </form>
    <% } %>

    <% if (stream.ended_at) { %>
      <label>Thank-you emails</label>
      <p>
        <% if (status === "sent") { %>
          <span class="tag email-sent">Sent to everyone who watched</span>
        <% } else if (status === "no-viewers") { %>
          <span class="tag">No viewers to email</span>
        <% } else if (status === "partial") { %>
          <span class="tag email-partial">Partially sent</span>
        <% } else { %>
          <span class="tag email-failed">Not sent</span>
        <% } %>
      </p>
      <% if (status === "partial" || status === "failed") { %>
        <form method="post" action="/admin/streams/<%= stream.slug %>/resend-thanks">
          <button class="btn secondary" type="submit">Retry Sending</button>
        </form>
        <p class="help">Only retries people who haven't successfully received it yet — safe to click again.</p>
      <% } %>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h2>Funeral details</h2>
      <a href="/admin/streams/<%= stream.slug %>/edit">Edit details</a>
    </div>
    <dl class="details">
      <dt>Date</dt><dd><%= fmtDateLong(stream.service_date) %><% if (stream.arrival_time) { %> · crew arrive <%= stream.arrival_time %><% } %></dd>
      <dt>Venue</dt>
      <dd>
        <%= [stream.venue_name, stream.venue_address].filter(Boolean).join(", ") || "—" %>
        <% if (stream.maps_link) { %> · <a href="<%= stream.maps_link %>" target="_blank" rel="noopener">Open in Google Maps</a><% } %>
      </dd>
      <dt>Came from</dt><dd><%= stream.lead_source || "—" %></dd>
      <dt>Client contact</dt><dd><%= [stream.contact_name, stream.contact_phone].filter(Boolean).join(" · ") || "—" %></dd>
      <dt>Kit</dt>
      <dd>
        <%= kit ? kit.name : "Not assigned" %>
        <% clashes.forEach(c => { %>
          <div class="warn-inline">⚠ <%= kit.name %> is also booked for <a href="/admin/streams/<%= c.slug %>"><%= c.title %></a> on the same day.</div>
        <% }) %>
      </dd>
      <% if (stream.crew_notes) { %><dt>Operator notes</dt><dd class="pre"><%= stream.crew_notes %></dd><% } %>
    </dl>
    <% if (!stream.maps_link || !stream.venue_name) { %>
      <p class="help warn-inline">Venue or Google Maps link missing — <a href="/admin/streams/<%= stream.slug %>/edit">add them</a> before asking operators.</p>
    <% } %>
  </div>

  <div class="panel" id="crew">
    <div class="panel-head">
      <h2>Camera operators</h2>
      <a href="/admin/crew">Manage crew list</a>
    </div>

    <% if (assignments.length === 0) { %>
      <p class="help">No operators added yet. Tick one or more people below, then ask each of them on WhatsApp.</p>
    <% } else { %>
      <table class="crew-table">
        <thead><tr><th>Operator</th><th>Own car</th><th>Status</th><th>WhatsApp</th><th></th></tr></thead>
        <tbody>
          <% assignments.forEach(a => { const base = `/admin/streams/${stream.slug}/crew/${a.id}`; %>
            <tr>
              <td><strong><%= a.name %></strong><div class="sub"><%= a.phone %></div></td>
              <td>
                <form method="post" action="<%= base %>/<%= a.uses_own_vehicle ? 'vehicle-no' : 'vehicle-yes' %>">
                  <button type="submit" class="toggle <%= a.uses_own_vehicle ? 'on' : '' %>" title="Click to change"><%= a.uses_own_vehicle ? "Yes" : "No" %></button>
                </form>
              </td>
              <td>
                <% if (a.status === "confirmed") { %><span class="tag crew-confirmed">Confirmed</span>
                <% } else if (a.status === "asked") { %><span class="tag crew-asked">Asked</span>
                <% } else if (a.status === "declined") { %><span class="tag crew-declined">Not available</span>
                <% } else { %><span class="tag">Not asked yet</span><% } %>
              </td>
              <td class="actions">
                <% if (a.status === "confirmed") { %>
                  <button type="button" class="btn small wa" data-wa="<%= a.confirmLink %>" data-post="<%= base %>/confirm">Send details again</button>
                <% } else if (a.status === "declined") { %>
                  <form method="post" action="<%= base %>/reset"><button class="btn small secondary" type="submit">Undo</button></form>
                <% } else { %>
                  <button type="button" class="btn small wa <%= a.status === 'asked' ? 'secondary' : '' %>" data-wa="<%= a.askLink %>" data-post="<%= base %>/ask"><%= a.status === "asked" ? "Ask again" : "Ask availability" %></button>
                  <% if (a.status === "asked") { %>
                    <button type="button" class="btn small wa" data-wa="<%= a.confirmLink %>" data-post="<%= base %>/confirm" data-confirm="Confirm <%= a.name.replace(/"/g, '') %> and send them the full brief?">They said yes — confirm &amp; send brief</button>
                    <form method="post" action="<%= base %>/decline"><button class="btn small secondary" type="submit">Said no</button></form>
                  <% } %>
                <% } %>
              </td>
              <td>
                <form method="post" action="<%= base %>/remove" onsubmit="return confirm('Remove <%= a.name.replace(/'/g, '') %> from this funeral?');">
                  <button class="link-btn" type="submit">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="help">Each WhatsApp button opens WhatsApp with the message already typed — just press <strong>Send</strong>. "Own car" changes the transport line in the brief.</p>
    <% } %>

    <% if (availableCrew.length) { %>
      <form method="post" action="/admin/streams/<%= stream.slug %>/crew/add" class="add-crew">
        <label style="margin-top:20px;">Add operators to ask</label>
        <div class="crew-picks">
          <% availableCrew.forEach(c => { %>
            <label class="pick">
              <input type="checkbox" name="crewIds" value="<%= c.id %>" />
              <span><strong><%= c.name %></strong> <span class="sub"><%= c.own_vehicle ? "· own car" : "· no car" %><%= c.notes ? " · " + c.notes : "" %></span></span>
            </label>
          <% }) %>
        </div>
        <button class="btn secondary" type="submit">Add selected</button>
      </form>
    <% } else if (assignments.length === 0) { %>
      <p class="help">Your crew list is empty — <a href="/admin/crew">add your camera operators</a> first.</p>
    <% } %>
  </div>

  <div class="panel" id="billing">
    <div class="panel-head">
      <h2>Quote &amp; invoice</h2>
      <a href="/admin/finance">Finance</a>
    </div>
    <div class="doc-cards">
      <% ["quote", "invoice"].forEach(kind => { const d = docs[kind]; const L = kind === "quote" ? "Quote" : "Invoice"; %>
        <div class="doc-card">
          <div class="doc-card-head">
            <strong><%= L %></strong>
            <% if (d) { %>
              <span class="sub"><%= d.number %></span>
              <% if (kind === "invoice") { %>
                <span class="tag <%= d.paid_at ? 'crew-confirmed' : 'crew-asked' %>"><%= d.paid_at ? "Paid" : "Unpaid" %></span>
              <% } %>
            <% } %>
          </div>
          <% if (d) { %>
            <div class="doc-amount">R<%= (d.total_cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, " ") %></div>
            <div class="doc-actions">
              <a class="btn small" href="/admin/streams/<%= stream.slug %>/<%= kind %>">View / PDF</a>
              <a class="btn small secondary" href="/admin/streams/<%= stream.slug %>/<%= kind %>/edit">Edit</a>
              <% if (kind === "invoice") { %>
                <form method="post" action="/admin/streams/<%= stream.slug %>/invoice/<%= d.paid_at ? 'unpaid' : 'paid' %>">
                  <button class="btn small secondary" type="submit"><%= d.paid_at ? "Mark unpaid" : "Mark paid" %></button>
                </form>
              <% } %>
              <form method="post" action="/admin/streams/<%= stream.slug %>/<%= kind %>/delete" onsubmit="return confirm('Delete this <%= kind %>?');">
                <button class="link-btn" type="submit">Delete</button>
              </form>
            </div>
          <% } else { %>
            <p class="help"><%= kind === "quote" ? "No quote yet." : (docs.quote ? "Ready to invoice from the quote." : "No invoice yet.") %></p>
            <a class="btn small <%= kind === 'invoice' && !docs.quote ? 'secondary' : '' %>" href="/admin/streams/<%= stream.slug %>/<%= kind %>/edit">
              <%= kind === "quote" ? "Create quote" : (docs.quote ? "Create invoice from quote" : "Create invoice") %>
            </a>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="panel">
    <h2 style="margin-top:0; font-size:18px;">Viewers who entered their email (<%= viewers.length %>)</h2>
    <% if (viewers.length === 0) { %>
      <p class="help">No one has entered their email for this stream yet.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Email</th><th>Name</th><th>Joined</th></tr></thead>
        <tbody>
          <% viewers.forEach(v => { %>
            <tr>
              <td><%= v.email %></td>
              <td><%= v.name || "—" %></td>
              <td><%= new Date(v.created_at + "Z").toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="panel">
    <h2 style="margin-top:0; font-size:18px;">Delete this stream</h2>
    <p class="help">Permanently removes the page, its link, the viewer list, and the chat history. This can't be undone — do this only if the stream was created by mistake or is no longer needed.</p>
    <form method="post" action="/admin/streams/<%= stream.slug %>/delete" onsubmit="return confirm('Permanently delete &quot;<%= stream.title.replace(/&quot;/g, '') %>&quot;? This cannot be undone.');">
      <button class="btn danger" type="submit">Delete Stream</button>
    </form>
  </div>
</div>

<script>
  // WhatsApp buttons: open WhatsApp with the message typed, record the
  // status change, then refresh this page to show it.
  document.querySelectorAll("button.wa").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (btn.dataset.confirm && !window.confirm(btn.dataset.confirm)) return;
      window.open(btn.dataset.wa, "_blank", "noopener");
      fetch(btn.dataset.post, { method: "POST" }).finally(() => location.reload());
    });
  });
</script>
</body>
</html>
