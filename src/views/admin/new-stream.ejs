<%- include("../partials/admin-head", { title: "New Livestream" }) %>
<%- include("../partials/admin-nav") %>

<div class="container doc-form-wrap">
  <h1>New Livestream</h1>
  <p class="help">Set up YoloBox → YoloLive as normal, then fill in the details below. This creates the public streaming page (email gate, video and live chat) with its own link, and puts the funeral on the calendar for crew booking.</p>

  <div class="panel">
    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/streams/new">
      <%- include("../partials/stream-fields", { f: form, kits, sources, accounts }) %>
      <button class="btn" type="submit">Create Livestream</button>
    </form>
  </div>
</div>
</body>
</html>
