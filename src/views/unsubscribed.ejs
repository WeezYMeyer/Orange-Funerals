<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Unsubscribed</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container narrow" style="text-align:center; padding-top:110px;">
    <% if (found) { %>
      <div class="tag ended" style="margin-bottom:18px;">Unsubscribed</div>
      <h1>You've been unsubscribed</h1>
      <p class="help">You won't receive any further emails from us. If this was a mistake, please contact the funeral home directly.</p>
    <% } else { %>
      <h1>Link not recognized</h1>
      <p class="help">This unsubscribe link isn't valid. If you'd like to stop receiving emails, please contact the funeral home directly.</p>
    <% } %>
  </div>
</body>
</html>
