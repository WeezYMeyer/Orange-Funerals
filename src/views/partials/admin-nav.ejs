<%
const path = typeof currentPath !== "undefined" ? currentPath : "";
const isStreams = path === "/" || (path.startsWith("/streams/") && path !== "/streams/new");
const isNew = path === "/streams/new";
const isCalendar = path === "/calendar";
const isCrew = path.startsWith("/crew");
const isBroadcast = path === "/broadcast";
const isFinance = path === "/finance";
const isSettings = path === "/settings";
%>
<div class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/admin">
      <span class="mark"><svg width="10" height="14" viewBox="0 0 10 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 0C5 0 6.7 2.3 6.7 3.5C6.7 4.4 5.9 5.1 5 5.1C4.1 5.1 3.3 4.4 3.3 3.5C3.3 2.3 5 0 5 0Z" fill="#b6924f"/><rect x="2.8" y="5.6" width="4.4" height="7.9" rx="0.8" fill="#faf8f5" stroke="#cddac2"/></svg></span>
      <span class="brand-text">
        <span class="brand-name">Orange Funeral</span>
        <span class="brand-tag">Live Stream Link Creation</span>
      </span>
    </a>
    <nav>
      <a href="/admin" class="<%= isStreams ? 'current' : '' %>">Streams</a>
      <a href="/admin/calendar" class="<%= isCalendar ? 'current' : '' %>">Calendar</a>
      <a href="/admin/crew" class="<%= isCrew ? 'current' : '' %>">Crew</a>
      <a href="/admin/finance" class="<%= isFinance ? 'current' : '' %>">Finance</a>
      <a href="/admin/streams/new" class="<%= isNew ? 'current' : '' %>">New Livestream</a>
      <a href="/admin/broadcast" class="<%= isBroadcast ? 'current' : '' %>">Broadcast</a>
      <a href="/admin/settings" class="<%= isSettings ? 'current' : '' %>">Settings</a>
      <form method="post" action="/admin/logout" style="display:inline">
        <button type="submit" class="logout-btn">Log out</button>
      </form>
    </nav>
  </div>
</div>
