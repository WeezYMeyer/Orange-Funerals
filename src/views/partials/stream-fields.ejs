<%# Shared by new-stream.ejs and edit-stream.ejs. Expects: f (form values), kits %>
<fieldset class="form-section">
  <legend>Livestream page <span class="legend-note">shown to viewers</span></legend>

  <label for="title">Title (e.g. "Service for John Smith")</label>
  <input type="text" id="title" name="title" required autofocus value="<%= f.title || '' %>" />

  <label for="serviceDate">Service date &amp; start time</label>
  <input type="datetime-local" id="serviceDate" name="serviceDate" required value="<%= f.serviceDate || '' %>" />

  <label for="embedCode">YoloLive embed code <span class="legend-note">optional — can be added later</span></label>
  <textarea id="embedCode" name="embedCode" class="short" placeholder="<iframe src=&quot;https://...&quot; ...></iframe>"><%= f.embedCode || '' %></textarea>
  <p class="help">Paste the full snippet YoloLive gives you, exactly as copied. Leave it empty to save the funeral now — viewers will see "the livestream will appear here" until you add it under <strong>Edit</strong>.</p>

  <label class="pick check-row">
    <input type="hidden" name="chatEnabled" value="0" />
    <input type="checkbox" name="chatEnabled" value="1" <%= f.chatEnabled === 0 || f.chatEnabled === "0" ? "" : "checked" %> />
    <span>Show live chat on this page</span>
  </label>
  <p class="help">Untick to hide the chat box for this funeral. You can also switch it on or off from the funeral page during the service.</p>
</fieldset>

<fieldset class="form-section">
  <legend>Funeral details <span class="legend-note">staff &amp; crew only — never shown to viewers</span></legend>

  <label for="branch">Branch</label>
  <select id="branch" name="branch">
    <option value="pretoria" <%= f.branch !== "capetown" ? "selected" : "" %>>Pretoria</option>
    <option value="capetown" <%= f.branch === "capetown" ? "selected" : "" %>>Cape Town</option>
  </select>
  <p class="help">Decides which bank account appears on this funeral's quote and invoice.</p>

  <div class="grid-2">
    <div>
      <label for="venueName">Venue name</label>
      <input type="text" id="venueName" name="venueName" required placeholder="e.g. NG Kerk Lyttelton" value="<%= f.venueName || '' %>" />
    </div>
    <div>
      <label for="venueAddress">Venue address</label>
      <input type="text" id="venueAddress" name="venueAddress" placeholder="Street, suburb" value="<%= f.venueAddress || '' %>" />
    </div>
  </div>

  <label for="mapsLink">Google Maps link</label>
  <input type="url" id="mapsLink" name="mapsLink" required placeholder="https://maps.app.goo.gl/..." value="<%= f.mapsLink || '' %>" />
  <p class="help">In Google Maps, find the venue → <strong>Share</strong> → <strong>Copy link</strong>, then paste it here.</p>

  <div class="grid-2">
    <div>
      <label for="contactName">Client contact name</label>
      <input type="text" id="contactName" name="contactName" placeholder="Family member or funeral director" value="<%= f.contactName || '' %>" />
    </div>
    <div>
      <label for="contactPhone">Client contact number</label>
      <input type="tel" id="contactPhone" name="contactPhone" placeholder="082 123 4567" value="<%= f.contactPhone || '' %>" />
    </div>
  </div>

  <div class="grid-2">
    <div>
      <label for="arrivalTime">Crew arrival time</label>
      <input type="time" id="arrivalTime" name="arrivalTime" value="<%= f.arrivalTime || '' %>" />
    </div>
    <div>
      <label for="kitId">Funeral kit</label>
      <select id="kitId" name="kitId">
        <option value="">— Not assigned yet —</option>
        <% kits.forEach(k => { %>
          <option value="<%= k.id %>" <%= String(f.kitId || '') === String(k.id) ? 'selected' : '' %>><%= k.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <label>Extra gear <span class="legend-note">on top of the kit — goes into the operator's brief and onto the quote &amp; invoice automatically</span></label>
  <div class="gear-head"><span>Item</span><span>Qty</span><span>Price each (R)</span><span></span></div>
  <div id="gearRows" class="gear-rows">
    <% const gearRows = (f.gear && f.gear.length) ? f.gear : [{ item: "", qty: "", price_cents: 0 }]; %>
    <% gearRows.forEach(g => { %>
      <div class="gear-row">
        <input type="text" name="gearItem" placeholder="e.g. Extra wireless mic, TV screen, extension reel" value="<%= g.item || '' %>" />
        <input type="text" name="gearQty" class="qty" placeholder="1" value="<%= g.qty || '' %>" />
        <input type="text" inputmode="decimal" name="gearPrice" placeholder="0 = included" value="<%= g.price_cents ? (g.price_cents / 100).toFixed(2) : '' %>" />
        <button type="button" class="link-btn gear-remove" title="Remove line">✕</button>
      </div>
    <% }) %>
  </div>
  <button type="button" class="btn small secondary" id="addGear">+ Add gear line</button>
  <script>
    (function () {
      const rows = document.getElementById("gearRows");
      document.getElementById("addGear").addEventListener("click", () => {
        const row = rows.querySelector(".gear-row").cloneNode(true);
        row.querySelectorAll("input").forEach((i) => (i.value = ""));
        rows.appendChild(row);
        row.querySelector("input").focus();
      });
      rows.addEventListener("click", (e) => {
        if (!e.target.classList.contains("gear-remove")) return;
        const row = e.target.closest(".gear-row");
        if (rows.querySelectorAll(".gear-row").length > 1) row.remove();
        else row.querySelectorAll("input").forEach((i) => (i.value = ""));
      });
    })();
  </script>

  <label for="leadSource">Where did this funeral come from?</label>
  <input type="text" id="leadSource" name="leadSource" list="leadSources" placeholder="e.g. AVBOB Centurion, NG Kerk, referral from…" value="<%= f.leadSource || '' %>" />
  <datalist id="leadSources">
    <% (typeof sources !== "undefined" ? sources : []).forEach(src => { %><option value="<%= src %>"></option><% }) %>
  </datalist>
  <p class="help">Type a new source or pick one you've used before — the Finance tab totals income per source.</p>

  <label for="accountClient">Who do we bill?</label>
  <% const homeList = (typeof accounts !== "undefined" ? accounts : []).slice();
     if (f.accountClient && !homeList.some(a => a.toLowerCase() === String(f.accountClient).toLowerCase())) homeList.push(f.accountClient); %>
  <select id="accountClient" name="accountClient">
    <option value="">The family directly (normal invoice)</option>
    <% if (homeList.length) { %>
      <optgroup label="Funeral home — billed on a statement">
        <% homeList.forEach(a => { %><option value="<%= a %>" <%= String(f.accountClient || "").toLowerCase() === a.toLowerCase() ? "selected" : "" %>><%= a %></option><% }) %>
      </optgroup>
    <% } %>
  </select>
  <p class="help">Pick the funeral home when they gave us the funeral: the quote and invoice are made out to them with their details, and it goes on their <a href="/admin/statements">statement</a>. Not on the list? Add it under <a href="/admin/funeral-homes" target="_blank">Funeral homes</a> (opens in a new tab), or save the funeral now and pick the funeral home later under Edit.</p>

  <div id="homeRef" class="home-ref" <%= f.accountClient ? "" : "hidden" %>>
    <div class="two-col">
      <div>
        <label for="lateName">Late (surname of the deceased)</label>
        <div class="prefix-input"><span>Late</span><input type="text" id="lateName" name="lateName" placeholder="e.g. Rohrs" value="<%= f.lateName || '' %>" /></div>
      </div>
      <div>
        <label for="bbNumber">BB number</label>
        <input type="text" id="bbNumber" name="bbNumber" placeholder="from the funeral home" value="<%= f.bbNumber || '' %>" />
      </div>
    </div>
    <p class="help">The funeral home's reference for this funeral — printed on the invoice and the statement as "Late Rohrs · BB …". You can add the BB number later under Edit.</p>
  </div>
  <script>
    (function () {
      const sel = document.getElementById("accountClient");
      const box = document.getElementById("homeRef");
      const late = document.getElementById("lateName");
      const title = document.getElementById("title");
      const sync = () => {
        box.hidden = !sel.value;
        // Suggest the surname from the title ("Service for John Smith" -> "Smith").
        if (sel.value && !late.value && title && title.value.trim()) late.value = title.value.trim().split(/\s+/).pop();
      };
      sel.addEventListener("change", sync);
    })();
  </script>

  <label for="crewNotes">Notes for the operator</label>
  <textarea id="crewNotes" name="crewNotes" class="short" placeholder="Parking, who to report to, dress code, camera position…"><%= f.crewNotes || '' %></textarea>
</fieldset>
